# CareHarbor AI configuration. Copy to .env and edit. Never commit .env.
# All data in this project is synthetic. Demo only - not medical advice.

# --- App ---
APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=8010
UI_PORT=5174
# Demo mode shows the mock OTP code in the UI and server log.
DEMO_MODE=true
CLINIC_TZ=Asia/Kolkata
# Multi-tenant isolation: users of this deployment can only retrieve documents tagged with this tenant (or global "*").
TENANT_ID=sunrise-clinic

# --- LLM (any OpenAI-compatible endpoint) ---
# Local default: Ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_FALLBACK_MODEL=qwen2.5:1.5b
# Faster model for short JSON classifications (router fallback, LLM safety 2nd layer). Leave empty to use LLM_MODEL.
LLM_FAST_MODEL=qwen2.5:1.5b
LLM_NUM_PREDICT=300
LLM_TEMPERATURE=0.1
LLM_KEEP_ALIVE=60m
LLM_TIMEOUT_S=120
# Set to "mock" to use the deterministic MockLLM (tests / no-model demos).
LLM_PROVIDER=openai
# Cloud alternative (free tier), e.g. Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.1-8b-instant

# --- Retrieval (vectorless RAG: document tree + BM25; no embeddings, no vector DB) ---
# bm25 = BM25 shortlist + deterministic tree navigation (default; <1 ms, measured 21/22 on the smoke set)
# tree = also let the LLM pick sections from a table of contents when the top documents are ambiguous
#        (costs one extra LLM call, ~6-10 s on a laptop CPU; worth it on a GPU or a fast cloud model)
RAG_MODE=bm25
RAG_TOP_K=3

# --- Storage ---
DB_PATH=data/careharbor.db
CHECKPOINT_DB_PATH=data/checkpoints.db
INDEX_DIR=data/index
TRACE_DIR=data/traces
# Reserved for a future Postgres (e.g. Neon) backend - not used yet; CareHarbor AI currently runs on SQLite (see docs/DEPLOYMENT.md).
DATABASE_URL=
# Saved conversations older than this many days are deleted at start-up (data minimisation). 0 = keep forever.
CHAT_RETENTION_DAYS=30
# A verified chat session expires after this many minutes (shared devices); records then need phone + DOB + OTP again. 0 = never.
VERIFIED_TTL_MINUTES=120

# --- Staff console + signing ---
STAFF_USERNAME=staff
STAFF_PASSWORD=change-me
# Signs chat session ids, the staff HttpOnly cookie, OTP hashes and privacy-preserving memory keys.
# setup.ps1 generates a random value. Changing it signs everyone out once.
SESSION_SECRET=change-me
# Retrieval pipeline: advanced = multi-query + reciprocal rank fusion + feature re-ranking + corrective retry; basic = one BM25 pass
RAG_PIPELINE=advanced

# --- Optional integrations ---
# Telegram adapter starts only if a token is set.
TELEGRAM_BOT_TOKEN=
# Langfuse tracing is optional.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Deployment (docker-compose.yml only; ignored by run.ps1) ---
# Public hostname Caddy gets an HTTPS certificate for, e.g. 140-238-1-2.sslip.io or careharbor.example.com
CAREHARBOR_DOMAIN=
# LLM endpoint seen from inside the container. Default: the bundled Ollama service. For Groq set https://api.groq.com/openai/v1
LLM_BASE_URL_DOCKER=
